{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flip7-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  // Room creation allocates storage and joining probes for live rooms, so both
  // are capped per client IP. A whole table shares one IP behind NAT, so the
  // join limit has to be generous; creation can be tight.
  "ratelimits": [
    { "name": "ROOM_CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3,  "period": 60 } },
    { "name": "ROOM_JOIN_LIMIT",   "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
